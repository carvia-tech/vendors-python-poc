# Company Information Intelligence Engine - Environment Configuration

# Copy this file to .env and configure your settings

# OpenAI API Configuration (Optional - app works without it)
# LLM_API_KEY=your-openai-api-key-here
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# Search Configuration
# SEARCH_MAX_RESULTS=10
# SEARCH_TIMEOUT=10

# Scraping Configuration
# SCRAPING_TIMEOUT=15
# SCRAPING_MAX_RETRIES=2
# SCRAPING_MAX_CONTENT_LENGTH=50000

# Google Reviews (Optional - app works without it, just skips this source)
# Needs a Google Cloud project with the (legacy) Places API enabled and
# billing set up - it's metered past a small free tier.
# GOOGLE_PLACES_API_KEY=your-google-places-api-key-here
